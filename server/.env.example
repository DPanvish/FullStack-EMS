# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ems

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Admin Email for System Alerts & Notifications
ADMIN_EMAIL=admin@example.com

# Inngest Background Jobs & Workflow
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# SMTP Email Configuration (e.g., Brevo / SendGrid / Custom SMTP)
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SENDER_EMAIL=notifications@yourdomain.com

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
PORT=4000

